{
  "name": "borodutch-tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "dev": "bun --filter @borodutch-tools/frontend dev",
    "dev:api": "bun --filter @borodutch-tools/backend dev",
    "build": "bun --filter @borodutch-tools/frontend build && bun --filter @borodutch-tools/backend build",
    "preview": "bun --filter @borodutch-tools/frontend preview",
    "check": "bun --filter @borodutch-tools/frontend check && bun --filter @borodutch-tools/backend check",
    "start": "bun --filter @borodutch-tools/backend start",
    "test": "bun --filter @borodutch-tools/backend test"
  },
  "packageManager": "bun@1.2.4"
}
